AuthType Basic
AuthName "Beaver - Staff Only"
AuthUserFile /home/c6924945/public_html/door-fujita.com/contents/Beaver/.htpasswd
Require valid-user

RewriteEngine On
RewriteBase /contents/Beaver/

# APIリクエストはそのまま通す
RewriteRule ^api/ - [L]

# 実ファイル・ディレクトリはそのまま
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# SPA フォールバック: すべて index.html へ
RewriteRule ^ index.html [L]
